        "text": "走。"
      },
      {
        "segment_id": "seg_002",
        "start_time": 7.77596875,
        "end_time": 8.65596875,
        "text": "為什麼？"
      },
      {
        "segment_id": "seg_003",
        "start_time": 12.57596875,
        "end_time": 15.17596875,
        "text": "妖孽，罪不可赦。"
      },
      {
        "segment_id": "seg_004",
        "start_time": 16.77596875,
        "end_time": 20.21596875,
        "text": "天罰，就此終結。"
      },
      {
        "segment_id": "seg_005",
        "start_time": 23.13596875,
        "end_time": 24.73596875,
        "text": "原來，我記得。"
      },
      {
        "segment_id": "seg_006",
        "start_time": 28.41596875,
        "end_time": 30.09596875,
        "text": "這是一段遙遠的記憶。"
      },
      {
        "segment_id": "seg_007",
        "start_time": 31.61596875,
        "end_time": 32.17596875,
        "text": "別怕。"
      },
      {
        "segment_id": "seg_008",
        "start_time": 33.78096875,
        "end_time": 35.78096875,
        "text": "我等你。"
      },
      {
        "segment_id": "seg_009",
        "start_time": 52.10096875,
        "end_time": 54.10096875,
        "text": "其實。"
      },
      {
        "segment_id": "seg_010",
        "start_time": 58.38096875,
        "end_time": 61.10096875,
        "text": "這股氣息。"
      },
      {
        "segment_id": "seg_011",
        "start_time": 66.72096875,
        "end_time": 68.28096875,
        "text": "天意如此。"
      },
      {
        "segment_id": "seg_012",
        "start_time": 71.88096875,
        "end_time": 74.12096875,
        "text": "我終於見到你。"
      }
